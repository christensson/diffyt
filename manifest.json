{
  "$schema": "https://json.schemastore.org/youtrack-app.json",
  "name": "diffyt",
  "title": "Diffyt",
  "description": "Compare versions of tickets and articles, or compare two of them, with a line-by-line diff.",
  "version": "0.1.0",
  "changeNotes": "Initial version.",
  "vendor": {
    "name": "Marcus Christensson",
    "url": "https://github.com/christensson/diffyt"
  },
  "minYouTrackVersion": "2025.1.0",
  "icon": "icon.svg",
  "widgets": [
    {
      "key": "ticket-versions",
      "name": "Compare versions",
      "description": "Compare summary, description and field versions of an issue",
      "indexPath": "ticket-versions/index.html",
      "iconPath": "ticket-versions/widget-icon.svg",
      "extensionPoint": "ISSUE_OPTIONS_MENU_ITEM",
      "permissions": [
        "READ_ISSUE"
      ],
      "expectedDimensions": {
        "width": 1200,
        "height": 800
      }
    },
    {
      "key": "ticket-compare",
      "name": "Compare with another ticket",
      "description": "Compare this ticket with another ticket",
      "indexPath": "ticket-compare/index.html",
      "iconPath": "ticket-compare/widget-icon.svg",
      "extensionPoint": "ISSUE_OPTIONS_MENU_ITEM",
      "permissions": [
        "READ_ISSUE"
      ],
      "expectedDimensions": {
        "width": 1200,
        "height": 800
      }
    },
    {
      "key": "article-versions",
      "name": "Compare versions",
      "description": "Compare title and content versions of an article",
      "indexPath": "article-versions/index.html",
      "iconPath": "article-versions/widget-icon.svg",
      "extensionPoint": "ARTICLE_OPTIONS_MENU_ITEM",
      "permissions": [
        "READ_ARTICLE"
      ],
      "expectedDimensions": {
        "width": 1200,
        "height": 800
      }
    },
    {
      "key": "article-compare",
      "name": "Compare with another article",
      "description": "Compare this article with another article",
      "indexPath": "article-compare/index.html",
      "iconPath": "article-compare/widget-icon.svg",
      "extensionPoint": "ARTICLE_OPTIONS_MENU_ITEM",
      "permissions": [
        "READ_ARTICLE"
      ],
      "expectedDimensions": {
        "width": 1200,
        "height": 800
      }
    }
  ]
}
